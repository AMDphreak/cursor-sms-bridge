# Port for HTTP + WebSocket (default 8787)
PORT=8787

# API key for REST calls from Cursor automations / scripts
API_KEY=change-me-to-a-long-random-string

# Pairing token shown in QR (regenerated on each start unless set)
# PAIRING_TOKEN=

# Optional: POST inbound SMS to this URL (Cursor automation webhook)
# WEBHOOK_URL=https://...

# Comma-separated E.164 numbers to forward (empty = forward all when phone connects)
# ALLOWED_NUMBERS=+15551234567,+15559876543
